@{
    ViewData["Title"] = "Dashboard";
}

<div class="row g-4 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-1">Total Books</div>
                <div class="fs-2 fw-bold text-primary">@ViewData["TotalBooks"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-1">Registered Users</div>
                <div class="fs-2 fw-bold text-success">@ViewData["TotalUsers"]</div>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <div class="text-muted small mb-1">Total Reviews</div>
                <div class="fs-2 fw-bold text-warning">@ViewData["TotalReviews"]</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-bold">Quick links</div>
    <div class="card-body d-flex gap-2">
        <a asp-area="Admin" asp-controller="Users" asp-action="Index"
           class="btn btn-outline-primary">Manage Users</a>
        <a asp-area="Admin" asp-controller="Books" asp-action="Index"
           class="btn btn-outline-secondary">Manage Books</a>
        <a asp-area="Admin" asp-controller="Reviews" asp-action="Index"
           class="btn btn-outline-warning">Manage Reviews</a>
    </div>
</div>