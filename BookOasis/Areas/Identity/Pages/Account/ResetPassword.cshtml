@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<link rel="stylesheet" href="~/css/auth.css" />

<div class="bo-auth-wrapper">
    <div class="bo-auth-panel">
        <div class="bo-auth-ornament">
            <span class="bo-auth-mark">BookOasis</span>
        </div>

        <h1 class="bo-auth-title">Reset Password</h1>
        <p class="bo-auth-subtitle">Choose a new password for your account</p>
        <hr class="bo-auth-hr" />

        <form method="post" class="bo-auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            <input asp-for="Input.Code" type="hidden" />

            <div class="form-floating">
                <input asp-for="Input.Email" class="form-control"
                       autocomplete="username" aria-required="true"
                       placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label">Email address</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input asp-for="Input.Password" class="form-control"
                       autocomplete="new-password" aria-required="true"
                       placeholder="New password" />
                <label asp-for="Input.Password" class="form-label">New Password</label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-floating">
                <input asp-for="Input.ConfirmPassword" class="form-control"
                       autocomplete="new-password" aria-required="true"
                       placeholder="Confirm new password" />
                <label asp-for="Input.ConfirmPassword" class="form-label">Confirm Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="bo-auth-btn bo-auth-btn-primary">Set New Password</button>
        </form>

        <div class="bo-auth-links">
            <a asp-page="./Login">Back to login</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
