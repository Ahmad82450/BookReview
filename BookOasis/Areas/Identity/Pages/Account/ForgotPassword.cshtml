@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<link rel="stylesheet" href="~/css/auth.css" />

<div class="bo-auth-wrapper">
    <div class="bo-auth-panel">
        <div class="bo-auth-ornament">
            <span class="bo-auth-mark">BookOasis</span>
        </div>

        <h1 class="bo-auth-title">Forgot Password?</h1>
        <p class="bo-auth-subtitle">We'll send a reset link to your inbox</p>
        <hr class="bo-auth-hr" />

        <form method="post" class="bo-auth-form">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <div class="form-floating">
                <input asp-for="Input.Email" class="form-control"
                       autocomplete="username" aria-required="true"
                       placeholder="name@example.com" />
                <label asp-for="Input.Email" class="form-label">Email address</label>
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <button type="submit" class="bo-auth-btn bo-auth-btn-primary">Send Reset Link</button>
        </form>

        <div class="bo-auth-links">
            <a asp-page="./Login">Back to login</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
