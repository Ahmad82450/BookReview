@page
@model LoginModel
@{
    ViewData["Title"] = "Log In";
}

<link rel="stylesheet" href="~/css/auth.css" />

<div class="bo-auth-wrapper">
    @{
        bool hasExternal = (Model.ExternalLogins?.Count ?? 0) > 0;
    }

    @if (hasExternal)
    {
        <!-- Two-column layout when external providers are available -->
        <div class="bo-auth-two-col">
            <!-- Local login -->
            <div class="bo-auth-panel" style="box-shadow:none; border:none; padding-right:0;">
                <div class="bo-auth-ornament">
                    <span class="bo-auth-mark">BookOasis</span>
                </div>
                <h1 class="bo-auth-title">Welcome Back</h1>
                <p class="bo-auth-subtitle">Sign in to your account</p>
                <hr class="bo-auth-hr" />

                <form id="account" method="post" class="bo-auth-form">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    <div class="form-floating">
                        <input asp-for="Input.Email" class="form-control"
                               autocomplete="username" aria-required="true"
                               placeholder="name@example.com" />
                        <label asp-for="Input.Email" class="form-label">Email</label>
                        <span asp-validation-for="Input.Email" class="text-danger"></span>
                    </div>

                    <div class="form-floating">
                        <input asp-for="Input.Password" class="form-control"
                               autocomplete="current-password" aria-required="true"
                               placeholder="password" />
                        <label asp-for="Input.Password" class="form-label">Password</label>
                        <span asp-validation-for="Input.Password" class="text-danger"></span>
                    </div>

                    <div class="bo-checkbox-row">
                        <input class="form-check-input" asp-for="Input.RememberMe" />
                        <label asp-for="Input.RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                    </div>

                    <button id="login-submit" type="submit" class="bo-auth-btn bo-auth-btn-primary">Log In</button>
                </form>

                <div class="bo-auth-links">
                    <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                    <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
                    <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
                </div>
            </div>

            <!-- Divider -->
            <div class="bo-auth-divider-col"></div>

            <!-- External logins -->
            <div style="padding-top:1rem;">
                <p class="bo-auth-section-title">Other sign-in options</p>
                <p class="bo-auth-section-note">Use a third-party service to log in.</p>
                <form id="external-account" asp-page="./ExternalLogin"
                      asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        <button type="submit" class="bo-auth-btn-external"
                                name="provider" value="@provider.Name"
                                title="Log in using your @provider.DisplayName account">
                            @provider.DisplayName
                        </button>
                    }
                </form>
            </div>
        </div>
    }
    else
    {
        <!-- Single-column layout -->
        <div class="bo-auth-panel">
            <div class="bo-auth-ornament">
                <span class="bo-auth-mark">BookOasis</span>
            </div>
            <h1 class="bo-auth-title">Welcome Back</h1>
            <p class="bo-auth-subtitle">Sign in to your account</p>
            <hr class="bo-auth-hr" />

            <form id="account" method="post" class="bo-auth-form">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                <div class="form-floating">
                    <input asp-for="Input.Email" class="form-control"
                           autocomplete="username" aria-required="true"
                           placeholder="name@example.com" />
                    <label asp-for="Input.Email" class="form-label">Email</label>
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <div class="form-floating">
                    <input asp-for="Input.Password" class="form-control"
                           autocomplete="current-password" aria-required="true"
                           placeholder="password" />
                    <label asp-for="Input.Password" class="form-label">Password</label>
                    <span asp-validation-for="Input.Password" class="text-danger"></span>
                </div>

                <div class="bo-checkbox-row">
                    <input class="form-check-input" asp-for="Input.RememberMe" />
                    <label asp-for="Input.RememberMe">@Html.DisplayNameFor(m => m.Input.RememberMe)</label>
                </div>

                <button id="login-submit" type="submit" class="bo-auth-btn bo-auth-btn-primary">Log In</button>
            </form>

            <div class="bo-auth-links">
                <a id="forgot-password" asp-page="./ForgotPassword">Forgot your password?</a>
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Create an account</a>
                <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email confirmation</a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
