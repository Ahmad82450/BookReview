@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Change Password";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
}

<link rel="stylesheet" href="~/css/manage.css" />

<h2 class="bo-manage-title">Change Password</h2>
<p class="bo-manage-subtitle">Update your account credentials</p>

<partial name="_StatusMessage" for="StatusMessage" />

<div class="bo-manage-card">
    <form id="change-password-form" method="post" class="bo-manage-form">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

        <div class="form-floating">
            <input asp-for="Input.OldPassword" class="form-control"
                   autocomplete="current-password" aria-required="true"
                   placeholder="Current password" />
            <label asp-for="Input.OldPassword" class="form-label"></label>
            <span asp-validation-for="Input.OldPassword" class="text-danger"></span>
        </div>

        <div class="form-floating">
            <input asp-for="Input.NewPassword" class="form-control"
                   autocomplete="new-password" aria-required="true"
                   placeholder="New password" />
            <label asp-for="Input.NewPassword" class="form-label"></label>
            <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
        </div>

        <div class="form-floating">
            <input asp-for="Input.ConfirmPassword" class="form-control"
                   autocomplete="new-password" aria-required="true"
                   placeholder="Confirm new password" />
            <label asp-for="Input.ConfirmPassword" class="form-label"></label>
            <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
        </div>

        <button type="submit" class="bo-btn-primary bo-btn-primary-full">
            Update Password
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
