@page
@model DeletePersonalDataModel
@{
    ViewData["Title"] = "Delete Personal Data";
    ViewData["ActivePage"] = ManageNavPages.PersonalData;
}

<link rel="stylesheet" href="~/css/manage.css" />

<h2 class="bo-manage-title">Delete Account</h2>
<p class="bo-manage-subtitle">This cannot be reversed</p>

<div class="bo-manage-card">
    <div class="bo-alert-danger">
        <strong>Deleting this data will permanently remove your account and all associated information. This action cannot be recovered.</strong>
    </div>

    <form id="delete-user" method="post" class="bo-manage-form">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

        @if (Model.RequirePassword)
        {
            <div class="form-floating">
                <input asp-for="Input.Password" class="form-control"
                       autocomplete="current-password" aria-required="true"
                       placeholder="Enter your password to confirm" />
                <label asp-for="Input.Password" class="form-label"></label>
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>
        }

        <button class="bo-btn-danger bo-btn-danger-full" type="submit">
            Yes, Delete My Account
        </button>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
