@model string

@if (!String.IsNullOrEmpty(Model))
{
    if (Model.StartsWith("Error"))
    {
        <div class="bo-alert-danger" role="alert" style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem;">
            <span>@Model</span>
            <button type="button"
                    onclick="this.parentElement.style.display='none'"
                    aria-label="Close"
                    style="background:none; border:none; cursor:pointer; color:var(--rust); font-size:1rem; line-height:1; padding:0; flex-shrink:0;">
                ✕
            </button>
        </div>
    }
    else
    {
        <div class="bo-status-ok" role="alert" style="display:flex; align-items:flex-start; justify-content:space-between; gap:1rem;">
            <span>@Model</span>
            <button type="button"
                    onclick="this.parentElement.style.display='none'"
                    aria-label="Close"
                    style="background:none; border:none; cursor:pointer; color:var(--forest); font-size:1rem; line-height:1; padding:0; flex-shrink:0;">
                ✕
            </button>
        </div>
    }
}
