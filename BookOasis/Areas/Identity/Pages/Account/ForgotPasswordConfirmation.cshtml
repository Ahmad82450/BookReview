@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Check Your Email";
}

<link rel="stylesheet" href="~/css/auth.css" />

<div class="bo-confirm-panel">
    <div class="bo-confirm-icon">📬</div>
    <h1 class="bo-confirm-title">Check Your Inbox</h1>
    <p class="bo-confirm-msg">
        If an account with that email exists, a password reset link has been sent.<br /><br />
        Please check your email and follow the instructions to reset your password.
    </p>
    <a asp-page="./Login" class="bo-confirm-link">Back to Login</a>
</div>
