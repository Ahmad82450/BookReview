@model BookOasis.Models.BooksModel

@{
    ViewData["Title"] = "Delete";
}

<link rel="stylesheet" href="~/css/books.css" />

<h1 class="bo-page-title">Remove Book</h1>
<p class="bo-subtitle">This action cannot be undone</p>

<div class="bo-card" style="max-width:640px;">
    <div class="bo-delete-warning">
        Are you sure you want to permanently remove this book from the collection?
    </div>

    <hr class="bo-divider" />

    <dl class="row bo-detail-list">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.bookName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.bookName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.bookISBN)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.bookISBN)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.bookAuthor)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.bookAuthor)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.bookDescription)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.bookDescription)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.bookReleaseDate)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.bookReleaseDate)</dd>
    </dl>

    <form asp-action="Delete" style="margin-top:1.8rem;">
        <input type="hidden" asp-for="BookID" />
        <div class="bo-action-row">
            <input type="submit" value="Yes, Delete" class="bo-btn bo-btn-danger" />
            <a asp-action="Index" class="bo-back-link" style="margin-top:0;">Cancel — Back to List</a>
        </div>
    </form>
</div>
