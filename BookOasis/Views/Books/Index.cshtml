@model IEnumerable<BookOasis.Models.BooksModel>

@{
    ViewData["Title"] = "Index";
}

<link rel="stylesheet" href="~/css/books.css" />

<h1 class="bo-page-title">The Collection</h1>
<p class="bo-subtitle">All books in the library</p>

@if (User.IsInRole("Admin"))
{
    <a asp-action="Create" class="bo-create-btn">+ Add New Book</a>
}

<div class="bo-table-wrapper">
    <table class="bo-table">
        <thead>
            <tr>
                <th>@Html.DisplayNameFor(model => model.bookName)</th>
                <th>@Html.DisplayNameFor(model => model.bookISBN)</th>
                <th>@Html.DisplayNameFor(model => model.bookAuthor)</th>
                <th>@Html.DisplayNameFor(model => model.bookDescription)</th>
                <th>@Html.DisplayNameFor(model => model.bookReleaseDate)</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@Html.DisplayFor(modelItem => item.bookName)</td>
                    <td>@Html.DisplayFor(modelItem => item.bookISBN)</td>
                    <td>@Html.DisplayFor(modelItem => item.bookAuthor)</td>
                    <td>@Html.DisplayFor(modelItem => item.bookDescription)</td>
                    <td>@Html.DisplayFor(modelItem => item.bookReleaseDate)</td>

                    @if (User.IsInRole("Admin"))
                    {
                        <td class="bo-actions">
                            <a asp-action="Edit" asp-route-id="@item.BookID" class="action-edit">Edit</a>
                            <span class="pipe">|</span>
                            <a asp-action="Delete" asp-route-id="@item.BookID" class="action-delete">Delete</a>
                            <span class="pipe">|</span>
                            <a asp-action="Details" asp-route-id="@item.BookID" class="action-details">Details</a>
                        </td>
                    }
                    else
                    {
                        <td class="bo-actions">
                            <a asp-action="Details" asp-route-id="@item.BookID" class="action-details">Details</a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
