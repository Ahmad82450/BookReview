@model BookOasis.Models.BooksModel

@{
    ViewData["Title"] = "Details";
}

<link rel="stylesheet" href="~/css/books.css" />

<h1 class="bo-page-title">Book Details</h1>
<p class="bo-subtitle">Full entry</p>

<div class="bo-card" style="max-width:640px;">
    <hr class="bo-divider" style="margin-top:0;" />
    <dl class="row bo-detail-list">
        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.bookName)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.bookName)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.bookISBN)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.bookISBN)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.bookAuthor)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.bookAuthor)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.bookDescription)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.bookDescription)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.bookReleaseDate)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.bookReleaseDate)</dd>
    </dl>

    <div class="bo-action-row">
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Edit" asp-route-id="@Model?.BookID" class="bo-btn bo-btn-primary">Edit</a>
        }
        <a asp-action="Index" class="bo-back-link" style="margin-top:0;">Back to List</a>
    </div>
</div>

<!-- ── Reviews ── -->
<h2 class="bo-reviews-title">Reviews</h2>

@if (User.Identity.IsAuthenticated)
{
    <div class="bo-review-form-card bo-form">
        <h4>Leave a Review</h4>
        <form asp-controller="Reviews" asp-action="Create" method="post">
            <input type="hidden" name="BookID" value="@Model?.BookID" />
            <input type="hidden" name="Book" value="@Model" />
            <input type="hidden" name="UserID" value="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />

            <div class="form-group">
                <label class="control-label" for="ReviewText">Your Review</label>
                <textarea name="ReviewText" class="form-control" required placeholder="Share your thoughts…"></textarea>
            </div>

            <div class="form-group">
                <label class="control-label" for="ReviewRating">Rating (1 – 5)</label>
                <input type="number" name="ReviewRating" class="form-control"
                       min="1" max="5" required placeholder="1 – 5" style="max-width:120px;" />
            </div>

            <div class="form-group" style="margin-top:1.2rem;">
                <input type="submit" value="Submit Review" class="bo-btn bo-btn-primary" />
            </div>
        </form>
    </div>
}
else
{
    <p class="bo-login-prompt">Please log in to leave a review.</p>
}

<div style="margin-top:1.2rem;">
    @if (Model.Reviews != null && Model.Reviews.Any())
    {
        @foreach (var review in Model.Reviews)
        {
            <div class="bo-review-card">
                <p class="bo-review-rating">
                    @for (int i = 0; i < review.ReviewRating; i++)
                    {
                        <span class="bo-star">★</span>
                    }
                    @for (int i = review.ReviewRating; i < 5; i++)
                    {
                        <span style="color:var(--border);">★</span>
                    }
                </p>
                <p class="bo-review-text">@review.ReviewText</p>
                <p class="bo-review-ts">@review.ReviewTimeStamp.ToString("g")</p>
            </div>
        }
    }
    else
    {
        <p class="bo-no-reviews">No reviews yet — be the first to share your thoughts.</p>
    }
</div>
